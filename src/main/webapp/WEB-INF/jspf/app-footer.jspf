<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav class="app-footer">
    <a href="${pageContext.request.contextPath}/home" class="nav-btn ${activePage == 'home' ? 'active' : ''}">
        <img src="https://img.icons8.com/?size=100&id=15988&format=png&color=580c1f" alt="Home">
        <small>Home</small>
    </a>
    <a href="${pageContext.request.contextPath}/adega" class="nav-btn ${activePage == 'adega' ? 'active' : ''}">
        <img src="https://img.icons8.com/?size=100&id=wB7OSDpKBQsG&format=png&color=580c1f" alt="Adega">
        <small>Adega</small>
    </a>
    <a href="${pageContext.request.contextPath}/favoritos" class="nav-btn ${activePage == 'favoritos' ? 'active' : ''}">
        <img src="https://img.icons8.com/?size=100&id=7936&format=png&color=580c1f" alt="Favoritos">
        <small>Favoritos</small>
    </a>
    <a href="${pageContext.request.contextPath}/carrinho" class="nav-btn ${activePage == 'carrinho' ? 'active' : ''}">
        <img src="https://img.icons8.com/?size=100&id=Ot2P5D5MPltM&format=png&color=580c1f" alt="Carrinho">
        <small>Carrinho</small>
        <c:if test="${sessionScope.totalCarrinho != null && sessionScope.totalCarrinho > 0}">
            <span class="nav-badge" data-cart-badge>${sessionScope.totalCarrinho}</span>
        </c:if>
    </a>
</nav>
